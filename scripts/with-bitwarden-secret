#!/usr/bin/env bash
set -Eeuo pipefail
# Check before any command that expands a secret-bearing variable.
if [[ $- == *x* ]]; then
    printf 'Bitwarden secret access refuses shell tracing\n' >&2
    exit 1
fi
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "$ROOT_DIR/lib/common.sh"
source "$ROOT_DIR/lib/bitwarden.sh"
if [[ $# -lt 5 || -z "$1" || -z "$2" || "$4" != -- || -z "$5" ]]; then
    die 'Usage: with-bitwarden-secret ITEM FIELD ENV_NAME -- COMMAND [ARGS...]'
fi
__bw_item="$1"
__bw_field="$2"
__bw_name="$3"
shift 4
[[ "$__bw_name" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || die 'Invalid environment variable name'
# Prevent shell state/loader manipulation and collisions with helper variables.
case "$__bw_name" in
    __bw_*|BW_*|BITWARDEN*|BASH*|SHELLOPTS|SHELL|ENV|PATH|HOME|IFS|CDPATH|GLOBIGNORE|LD_*|DYLD_*|NODE_OPTIONS|PYTHONPATH|PYTHONHOME|RUBYOPT|PERL5OPT|PS[0-9]|PROMPT_COMMAND|ROOT_DIR|NVM_DIR|UID|EUID|PPID|SHLVL|RANDOM|SECONDS|LINENO|FUNCNAME|DIRSTACK|GROUPS|PIPESTATUS|OPTIND|OPTARG|PWD|OLDPWD|_)
        die 'Use an application-specific environment variable, not a shell/runtime or Bitwarden variable' ;;
esac
bitwarden_guard || exit 1
BITWARDEN_RELOCK=false
trap bitwarden_cleanup_session EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
bitwarden_authenticate || exit 1
# A non-newline suffix preserves trailing newlines through command substitution.
__bw_value="$(bitwarden_get_field "$__bw_item" "$__bw_field" && printf '.')" || exit 1
__bw_value="${__bw_value%.}"
__bw_status=0
(
    export "$__bw_name=$__bw_value"
    unset __bw_value BW_SESSION BW_CLIENTID BW_CLIENTSECRET BW_PASSWORD
    # No external env command: a secret must never become a process argument.
    exec "$@"
) || __bw_status=$?
unset __bw_value
exit "$__bw_status"
